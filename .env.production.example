# Copy to .env.production. Never commit real secrets.
POSTGRES_DB=classping_production
POSTGRES_USER=classping_production
# Use a random hexadecimal password (URL-safe).
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=Asia/Jakarta
PRODUCTION_PORT=8001
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:8001
# For public deployment: HTTPS URLs, real domains, and HTTPS_ENABLED=True.
HTTPS_ENABLED=False
TRUST_PROXY_HEADERS=False
PASSWORD_RESET_URL=http://localhost:3000/reset-password/
SCHOOL_PASSWORD_RESET_URL=http://localhost:3001/reset-password/
API_DOCS_ENABLED=False
STORAGE_TYPE=r2
R2_BUCKET_NAME=classping-production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Production Compose also sets this URL for its bundled Redis service.
REDIS_URL=redis://redis:6379/0
UPLOAD_METADATA_TTL=3600
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ClassPing
# SMTP defaults to Mailjet; credentials fall back to Mailjet API credentials.
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Active payment aggregator for new checkouts/withdrawals (rintisan).
PAYMENT_PROVIDER=dana
# Payment aggregator (Rintisan). Keys are PEM text; a one-line value can use \n for newlines.
RINTISAN_ENV=sandbox
RINTISAN_CLIENT_ID=
RINTISAN_API_KEY=
CLASSPING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
RINTISAN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
RINTISAN_CALLBACK_TOKEN=
RINTISAN_PAYER_EMAIL=no-reply@hamanto.com
RINTISAN_REQUIRE_TRANSFER_CALLBACK_SIGNATURE=True
# Payment aggregator (DANA). Keys are PEM text; a one-line value can use \n for newlines.
DANA_ENV=production
DANA_MERCHANT_ID=
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
# DANA_CHANNEL_ID=95221 (optional; the value DANA's SDKs send)
DANA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DANA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
DANA_RETURN_URL=
# Optional: DANA_NOTIFY_URL (default SITE_URL + /api/webhooks/payment/), DANA_MCC (default 8211),
# DANA_BASE_URL (default per DANA_ENV)
